# Copy this file to `.env` and fill in your values.

# Example Postgres (production) — replace placeholders:
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>

# Example local Postgres:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/invoice_db

# Or use a local SQLite for quick development (default when DATABASE_URL is unset):
# DATABASE_URL=sqlite:///./invoice.db
